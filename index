const state = { mentor: null, program: null, priority: null };

function fmt(n){ return n.toFixed(1)+'%'; }
function short(p){ return p.split(' - ')[0]; }

// populate filter selects
const progSel = document.getElementById('progSel');
RAW.programs.forEach((p,i)=>progSel.insertAdjacentHTML('beforeend',`<option value="${i}">${p}</option>`));
const priSel = document.getElementById('priSel');
RAW.priorities.forEach((p,i)=>priSel.insertAdjacentHTML('beforeend',`<option value="${i}">${p}</option>`));

progSel.addEventListener('change', ()=>{ state.program = progSel.value===''?null:+progSel.value; render(); });
priSel.addEventListener('change', ()=>{ state.priority = priSel.value===''?null:+priSel.value; render(); });
document.getElementById('mentorSearch').addEventListener('input', render);
document.getElementById('clearAll').addEventListener('click', ()=>{
  state.mentor=null; state.program=null; state.priority=null;
  progSel.value=''; priSel.value=''; document.getElementById('mentorSearch').value='';
  render();
});

function filteredRows(ignore){
  return RAW.rows.filter(r=>
    (ignore==='mentor' || state.mentor===null || r[0]===state.mentor) &&
    (ignore==='program' || state.program===null || r[1]===state.program) &&
    (ignore==='priority' || state.priority===null || r[2]===state.priority)
  );
}

function aggBy(rows, dim){
  const m = new Map();
  rows.forEach(r=>{
    const k = r[dim];
    if(!m.has(k)) m.set(k, {total:0,paid:0,not_paid:0,partial:0});
    const o = m.get(k);
    o.total+=r[3]; o.paid+=r[4]; o.not_paid+=r[5]; o.partial+=r[6];
  });
  return m;
}

function renderChips(){
  const chips = [];
  if(state.mentor!==null) chips.push({label: RAW.mentors[state.mentor], key:'mentor'});
  if(state.program!==null) chips.push({label: RAW.programs[state.program], key:'program'});
  if(state.priority!==null) chips.push({label: short(RAW.priorities[state.priority]), key:'priority'});
  document.getElementById('chips').innerHTML = chips.map(c=>`<button class="chip" data-k="${c.key}">${c.label} <span class="x">✕</span></button>`).join('');
  document.querySelectorAll('.chip').forEach(b=>b.addEventListener('click', ()=>{
    const k = b.dataset.k;
    state[k] = null;
    if(k==='program') progSel.value='';
    if(k==='priority') priSel.value='';
    render();
  }));
  document.getElementById('clearAll').style.display = chips.length ? 'inline-block' : 'none';
}

function render(){
  renderChips();
  const rows = filteredRows(null);
  const totals = {total:0,paid:0,not_paid:0};
  rows.forEach(r=>{ totals.total+=r[3]; totals.paid+=r[4]; totals.not_paid+=r[5]; });
  const overallPct = totals.total ? totals.paid/totals.total*100 : 0;

  // Mentor ranking (aggregate over rows matching program+priority filters, ignoring mentor filter for the list itself unless search narrows)
  const mentorRows = filteredRows('mentor');
  const mAgg = aggBy(mentorRows, 0);
  let mentorList = [...mAgg.entries()].map(([idx,o])=>({
    idx, name: RAW.mentors[idx], total:o.total, paid:o.paid, not_paid:o.not_paid,
    paid_pct: o.total? o.paid/o.total*100 : 0
  })).sort((a,b)=>b.paid_pct-a.paid_pct);

  const searchQ = document.getElementById('mentorSearch').value.toLowerCase();
  if(searchQ) mentorList = mentorList.filter(m=>m.name.toLowerCase().includes(searchQ));

  // Top performer (unfiltered by mentor, respects program/priority filters)
  const allMentorAgg = [...aggBy(filteredRows('mentor'), 0).entries()].map(([idx,o])=>({
    idx, name: RAW.mentors[idx], total:o.total, paid:o.paid, not_paid:o.not_paid, paid_pct: o.total? o.paid/o.total*100:0
  })).sort((a,b)=>b.paid_pct-a.paid_pct);

  const kpis = [
    {label:'Students (filtered)', value: totals.total.toLocaleString(), sub: rows.length===RAW.rows.length?'all students':'filtered view'},
    {label:'Paid', value: fmt(overallPct), sub:`${totals.paid.toLocaleString()} of ${totals.total.toLocaleString()}`},
    {label:'Not paid', value: totals.not_paid.toLocaleString(), sub:'re-registration pending'},
    {label: state.mentor!==null?'Selected mentor':'Top performer', value: state.mentor!==null? RAW.mentors[state.mentor] : (allMentorAgg[0]?allMentorAgg[0].name:'—'), sub: state.mentor!==null? fmt(mentorList.find(m=>m.idx===state.mentor)?.paid_pct||0)+' paid' : (allMentorAgg[0]?fmt(allMentorAgg[0].paid_pct)+' paid':'')},
  ];
  document.getElementById('kpis').innerHTML = kpis.map(k=>`<div class="kpi"><div class="label">${k.label}</div><div class="value">${k.value}</div><div class="sub">${k.sub}</div></div>`).join('');

  // Top card
  const best = allMentorAgg[0];
  if(best){
    document.getElementById('topCard').innerHTML = `
      <div class="tag">Best performing mentor${state.program!==null||state.priority!==null?' (in current filter)':''}</div>
      <h3>${best.name} — ${fmt(best.paid_pct)} paid</h3>
      <p>${best.paid.toLocaleString()} of ${best.total.toLocaleString()} students paid${best.paid_pct-overallPct>=0?`, ${(best.paid_pct-overallPct).toFixed(1)} points above the current average of ${fmt(overallPct)}.`:'.'}</p>`;
  } else {
    document.getElementById('topCard').innerHTML = `<div class="tag">No data</div><h3>No students match this filter</h3><p>Try clearing a filter.</p>`;
  }

  // Mentor chart with drill-down program pills for selected/hovered mentor
  document.getElementById('mentorHeading').textContent = state.mentor!==null ? `${RAW.mentors[state.mentor]} — program breakdown` : 'Mentor-wise re-registration status';
  if(mentorList.length===0){
    document.getElementById('mentorChart').innerHTML = `<div class="empty">No mentors match this filter.</div>`;
  } else {
    document.getElementById('mentorChart').innerHTML = mentorList.map((m,i)=>{
      const isActive = state.mentor===m.idx;
      let pillsHtml = '';
      if(isActive){
        const progAgg = aggBy(RAW.rows.filter(r=>r[0]===m.idx && (state.priority===null||r[2]===state.priority)), 1);
        const pills = [...progAgg.entries()].map(([idx,o])=>`<span class="pill">${RAW.programs[idx]} <b>${fmt(o.total?o.paid/o.total*100:0)}</b> (${o.total})</span>`).join('');
        pillsHtml = `<div class="pills">${pills}</div>`;
        const noteText = NOTES[m.name];
        if(noteText){
          pillsHtml += `<div class="focus-note"><span class="flabel">Focus for ${m.name}</span>${noteText}</div>`;
        }
      }
      return `<div class="row ${isActive?'active':''}" data-mentor="${m.idx}">
        <div class="row-head">
          <div class="rank">${i+1}</div>
          <div class="name" title="${m.name}">${m.name}</div>
          <div class="bar-track"><div class="bar-fill" style="width:${m.paid_pct}%"></div></div>
          <div class="meta"><b>${fmt(m.paid_pct)}</b> · ${m.not_paid} unpaid</div>
        </div>
        ${pillsHtml}
      </div>`;
    }).join('');
    document.querySelectorAll('#mentorChart .row').forEach(el=>el.addEventListener('click', ()=>{
      const idx = +el.dataset.mentor;
      state.mentor = state.mentor===idx ? null : idx;
      render();
    }));
  }

  // Program chart
  document.getElementById('programHeading').textContent = state.program!==null ? `${RAW.programs[state.program]} — re-registration status` : 'Program-wise re-registration status';
  const progAggAll = [...aggBy(filteredRows('program'), 1).entries()].map(([idx,o])=>({
    idx, name: RAW.programs[idx], total:o.total, paid:o.paid, not_paid:o.not_paid, paid_pct:o.total?o.paid/o.total*100:0
  })).sort((a,b)=>a.paid_pct-b.paid_pct);
  document.getElementById('programChart').innerHTML = progAggAll.map(p=>{
    const isActive = state.program===p.idx;
    return `<div class="row ${isActive?'active':''}" data-program="${p.idx}">
      <div class="row-head">
        <div class="rank"></div>
        <div class="name">${p.name}</div>
        <div class="bar-track"><div class="bar-fill" style="width:${p.paid_pct}%"></div></div>
        <div class="meta"><b>${fmt(p.paid_pct)}</b> · ${p.not_paid.toLocaleString()} unpaid</div>
      </div>
    </div>`;
  }).join('');
  document.querySelectorAll('#programChart .row').forEach(el=>el.addEventListener('click', ()=>{
    const idx = +el.dataset.program;
    state.program = state.program===idx ? null : idx;
    progSel.value = state.program===null ? '' : idx;
    render();
  }));

  // Priority table
  document.getElementById('priorityHeading').textContent = state.priority!==null ? `${RAW.priorities[state.priority]} — detail` : 'Priority category breakdown';
  const priAgg = [...aggBy(filteredRows('priority'), 2).entries()].map(([idx,o])=>({
    idx, name: RAW.priorities[idx], total:o.total, paid:o.paid, not_paid:o.not_paid,
    not_paid_pct: o.total? o.not_paid/o.total*100 : 0
  })).sort((a,b)=>b.not_paid-a.not_paid);
  document.getElementById('priBody').innerHTML = priAgg.length ? priAgg.map(p=>{
    const cls = p.not_paid_pct>=60?'neg':(p.not_paid_pct>=25?'warn':'pos');
    const isActive = state.priority===p.idx;
    return `<tr class="${isActive?'active':''}" data-priority="${p.idx}">
      <td>${p.name}</td>
      <td class="num">${p.total.toLocaleString()}</td>
      <td class="num">${p.paid.toLocaleString()}</td>
      <td class="num">${p.not_paid.toLocaleString()}</td>
      <td class="num"><span class="badge ${cls}">${fmt(p.not_paid_pct)}</span></td>
    </tr>`;
  }).join('') : `<tr><td colspan="5" class="empty">No data for this filter.</td></tr>`;
  document.querySelectorAll('#priBody tr[data-priority]').forEach(el=>el.addEventListener('click', ()=>{
    const idx = +el.dataset.priority;
    state.priority = state.priority===idx ? null : idx;
    priSel.value = state.priority===null ? '' : idx;
    render();
  }));
}

function renderISDA(){
  const maxAbs = Math.max(...ISDA.map(d=>Math.abs(d.diff)));
  document.getElementById('isdaChart').innerHTML = ISDA.map(d=>{
    const cls = d.diff<0?'neg':'';
    const width = (Math.abs(d.diff)/maxAbs*50).toFixed(1);
    const left = d.diff>=0 ? '50%' : (50-parseFloat(width))+'%';
    const sign = d.diff>0?'+':'';
    return `<div class="div-row">
      <div class="name" title="${d.name}">${d.name}</div>
      <div class="div-track">
        <div class="div-mid"></div>
        <div class="div-fill ${cls}" style="left:${left}; width:${width}%"></div>
      </div>
      <div class="meta">IS ${d.is_pct}% · DA ${d.da_pct}% · <b class="${cls}">${sign}${d.diff}</b></div>
    </div>`;
  }).join('');
}
renderISDA();

render();
</script>
