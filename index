<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Re-Registration Dashboard</title>
<style>
  :root{
    --ink:#1b2430; --ink-soft:#5b6674; --line:#e2e6ea;
    --bg:#f6f7f9; --card:#ffffff;
    --navy:#26415e; --navy-deep:#182b40; --navy-light:#e7edf3;
    --gold:#c9962c;
    --pos:#2f7d5c; --pos-bg:#e7f3ed;
    --neg:#b1483f; --neg-bg:#fbebe9;
    --warn:#b17a1f; --warn-bg:#fbf1e0;
    --track:#eef1f4;
    padding-top: env(safe-area-inset-top,0px);
    padding-bottom: env(safe-area-inset-bottom,0px);
    box-sizing:border-box;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --ink:#e8ebef; --ink-soft:#9aa5b1; --line:#2a3340;
      --bg:#12161c; --card:#181e26;
      --navy:#7fa2c9; --navy-deep:#0d1218; --navy-light:#1c2a38;
      --gold:#e0b45c;
      --pos:#5fc79a; --pos-bg:#173226;
      --neg:#e8837a; --neg-bg:#331d1c;
      --warn:#e0b45c; --warn-bg:#332b17;
      --track:#232a34;
    }
  }
  :root[data-theme="dark"]{
    --ink:#e8ebef; --ink-soft:#9aa5b1; --line:#2a3340;
    --bg:#12161c; --card:#181e26;
    --navy:#7fa2c9; --navy-deep:#0d1218; --navy-light:#1c2a38;
    --gold:#e0b45c;
    --pos:#5fc79a; --pos-bg:#173226;
    --neg:#e8837a; --neg-bg:#331d1c;
    --warn:#e0b45c; --warn-bg:#332b17;
    --track:#232a34;
  }
  html{scroll-padding-top:env(safe-area-inset-top,0px); height:100%;}
  *{box-sizing:border-box;}
  body{margin:0; min-height:100%; background:var(--bg); color:var(--ink); font-family:'Source Serif Pro',Georgia,'Times New Roman',serif;}
  .num{font-family:'IBM Plex Mono','Courier New',monospace; font-variant-numeric:tabular-nums;}
  header{background:linear-gradient(160deg,var(--navy-deep),var(--navy)); color:#f2f4f7; padding:24px 20px 18px; padding-top:calc(24px + env(safe-area-inset-top,0px));}
  header .wrap{max-width:1180px;margin:0 auto;}
  header h1{font-size:24px; margin:0 0 4px; font-weight:600;}
  header p{margin:0; color:#c7d2de; font-size:13.5px; max-width:64ch;}

  .filterbar{position:sticky; top:0; z-index:5; background:var(--card); border-bottom:1px solid var(--line); padding:10px 20px; padding-top:env(safe-area-inset-top,0px);}
  .filterbar .wrap{max-width:1180px; margin:0 auto; display:flex; gap:10px; flex-wrap:wrap; align-items:center; font-family:Arial,sans-serif;}
  .filterbar select, .filterbar input{font-family:Arial,sans-serif; font-size:13px; padding:6px 10px; border:1px solid var(--line); border-radius:6px; background:var(--card); color:var(--ink);}
  .filterbar input{flex:1; min-width:140px;}
  .chip{display:inline-flex; align-items:center; gap:6px; font-size:12px; background:var(--navy-light); color:var(--navy); padding:4px 10px; border-radius:20px; cursor:pointer; border:none;}
  .chip .x{font-weight:700;}
  #clearAll{display:none; font-size:12px; color:var(--ink-soft); background:none; border:1px solid var(--line); border-radius:6px; padding:6px 10px; cursor:pointer; font-family:Arial,sans-serif;}

  main{max-width:1180px; margin:0 auto; padding:20px 20px 60px;}
  .top-card{background:linear-gradient(135deg,var(--pos-bg),var(--card)); border:1px solid var(--pos); border-radius:8px; padding:16px 18px; margin-bottom:22px;}
  .top-card .tag{font-family:Arial,sans-serif; font-size:11px; text-transform:uppercase; letter-spacing:.06em; color:var(--pos); font-weight:700;}
  .top-card h3{margin:6px 0 4px; font-size:19px;}
  .top-card p{margin:0; font-size:13.5px; color:var(--ink); font-family:Arial,sans-serif; line-height:1.5;}

  .kpis{display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:22px;}
  .kpi{background:var(--card); border:1px solid var(--line); border-radius:8px; padding:14px 16px; box-shadow:0 4px 14px rgba(20,30,45,.06); transition:box-shadow .15s;}
  .kpi .label{font-size:11.5px; color:var(--ink-soft); text-transform:uppercase; letter-spacing:.06em; font-family:Arial,sans-serif;}
  .kpi .value{font-size:23px; margin-top:4px; font-weight:700;}
  .kpi .sub{font-size:12px; color:var(--ink-soft); margin-top:2px;}

  section{margin-bottom:30px;}
  h2{font-size:16px; font-weight:700; margin:0 0 4px;}
  .section-note{font-size:12.5px; color:var(--ink-soft); margin:0 0 14px; font-family:Arial,sans-serif;}
  .chart-card{background:var(--card); border:1px solid var(--line); border-radius:8px; padding:14px 18px 6px;}

  .row{padding:8px 0; border-bottom:1px solid var(--line); cursor:pointer; border-radius:6px; transition:background .1s;}
  .row:hover{background:var(--track);}
  .row.active{background:var(--navy-light);}
  .row:last-child{border-bottom:none;}
  .row-head{display:grid; grid-template-columns:22px 180px 1fr 128px; align-items:center; gap:10px;}
  .row-head .rank{font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--ink-soft);}
  .row-head .name{font-size:13.5px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .bar-track{position:relative; height:15px; background:var(--track); border-radius:3px; overflow:hidden;}
  .bar-fill{position:absolute; left:0; top:0; height:100%; background:var(--navy); transition:width .2s;}
  .meta{font-size:12px; text-align:right; color:var(--ink-soft); font-family:Arial,sans-serif; white-space:nowrap;}
  .meta b{color:var(--ink); font-family:'IBM Plex Mono','Courier New',monospace;}
  .pills{grid-column:2/-1; display:flex; flex-wrap:wrap; gap:6px; margin-top:6px;}
  .pill{font-family:Arial,sans-serif; font-size:11px; padding:2px 8px; border-radius:20px; background:var(--track); color:var(--ink-soft); white-space:nowrap;}
  .pill b{color:var(--ink); font-family:'IBM Plex Mono',monospace;}
  .focus-note{grid-column:2/-1; margin-top:8px; padding:10px 12px; background:var(--warn-bg); border:1px solid var(--warn); border-radius:6px; font-family:Arial,sans-serif; font-size:12.5px; color:var(--ink); line-height:1.5;}
  .focus-note .flabel{font-size:10.5px; text-transform:uppercase; letter-spacing:.05em; color:var(--warn); font-weight:700; display:block; margin-bottom:3px;}

  .table-wrap{overflow-x:auto; border:1px solid var(--line); border-radius:8px; background:var(--card);}
  table{border-collapse:collapse; width:100%; min-width:560px; font-size:13px;}
  th, td{padding:9px 12px; text-align:right; border-bottom:1px solid var(--line); white-space:nowrap;}
  th:first-child, td:first-child{text-align:left; position:sticky; left:0; background:var(--card);}
  th{font-family:Arial,sans-serif; font-size:11px; text-transform:uppercase; letter-spacing:.04em; color:var(--ink-soft); background:var(--card);}
  tbody tr{cursor:pointer;}
  tbody tr:hover td{background:var(--track);}
  tbody tr.active td{background:var(--navy-light);}
  .badge{display:inline-block; padding:2px 8px; border-radius:20px; font-size:12px; font-family:Arial,sans-serif;}
  .badge.pos{background:var(--pos-bg); color:var(--pos);}
  .badge.neg{background:var(--neg-bg); color:var(--neg);}
  .badge.warn{background:var(--warn-bg); color:var(--warn);}
  .empty{padding:20px; text-align:center; color:var(--ink-soft); font-family:Arial,sans-serif; font-size:13px;}

  .div-row{display:grid; grid-template-columns:180px 1fr 130px; align-items:center; gap:10px; padding:6px 0; border-bottom:1px solid var(--line);}
  .div-row:last-child{border-bottom:none;}
  .div-row .name{font-size:13px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .div-track{position:relative; height:15px; background:var(--track); border-radius:3px;}
  .div-mid{position:absolute; left:50%; top:-2px; width:1px; height:19px; background:var(--ink-soft); opacity:.4;}
  .div-fill{position:absolute; top:0; height:100%; border-radius:2px; background:var(--navy);}
  .div-fill.neg{background:var(--neg);}
  .div-row .meta{font-size:12px; text-align:right; font-family:Arial,sans-serif; color:var(--ink-soft); white-space:nowrap;}
  .div-row .meta b{color:var(--ink); font-family:'IBM Plex Mono','Courier New',monospace;}
  .div-row .meta b.neg{color:var(--neg);}

  footer{max-width:1180px; margin:0 auto; padding:0 20px 30px; font-size:11.5px; color:var(--ink-soft); font-family:Arial,sans-serif;}
  @media (max-width:720px){
    .kpis{grid-template-columns:repeat(2,1fr);}
    .row-head{grid-template-columns:18px 1fr 80px; gap:6px;}
    .pills{grid-column:1/-1;}
  }
</style>
</head>
